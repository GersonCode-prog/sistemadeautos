---
// Plantilla del sitio PÚBLICO (lo ve cualquier visitante, sin iniciar sesión)
import '../styles/global.css';
import { ruta } from '../lib/ruta';

interface Props { titulo: string; descripcion?: string }
const { titulo, descripcion = 'Autos seminuevos y nuevos en Guatemala. Encuentra tu próximo vehículo en AutoGestión GT.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo} | AutoGestión GT</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚗</text></svg>" />
  </head>
  <body class="sitio">
    <header class="cabecera">
      <div class="envoltura cabecera-fila">
        <a href={ruta('/')} class="marca"><span class="marca-icono">🚗</span><span class="marca-texto">Auto<strong>Gestión</strong><span class="gt"> GT</span></span></a>
        <nav class="nav" id="nav">
          <a href={ruta('/')}>Catálogo</a>
          <a href={ruta('/#por-que')}>Nosotros</a>
          <a href={ruta('/#contacto')}>Contacto</a>
        </nav>
        <!-- Si hay sesión, el botón cambia a "Ir al panel" -->
        <a href={ruta('/login')} class="btn btn-primario" id="btn-acceso" data-panel={ruta('/dashboard')}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
          <span>Iniciar sesión</span>
        </a>
      </div>
    </header>

    <slot />

    <footer class="pie" id="contacto">
      <div class="envoltura pie-rejilla">
        <div>
          <p class="marca"><span class="marca-icono">🚗</span><span>Auto<strong>Gestión</strong> GT</span></p>
          <p class="pie-texto">Tu agencia de confianza para comprar vehículos nuevos y seminuevos en Guatemala.</p>
        </div>
        <div>
          <h4>Contacto</h4>
          <p>📍 Zona 10, Ciudad de Guatemala</p>
          <p>📞 2222-3333</p>
          <p>✉️ ventas@autogestion.gt</p>
        </div>
        <div>
          <h4>Horario</h4>
          <p>Lunes a viernes: 8:00 – 18:00</p>
          <p>Sábado: 8:00 – 13:00</p>
        </div>
      </div>
      <p class="derechos">© {new Date().getFullYear()} AutoGestión GT · Sitio de demostración</p>
    </footer>

    <script>
      import { usuarioActual } from '../lib/sesion';
      const boton = document.getElementById('btn-acceso') as HTMLAnchorElement;
      const u = usuarioActual();
      if (u) {
        boton.href = boton.dataset.panel!;
        boton.querySelector('span')!.textContent = 'Ir al panel';
      }
    </script>

    <style>
      .sitio { background: #fff; }
      :global(.envoltura) { width: min(1180px, 100% - 2.5rem); margin-inline: auto; }

      .cabecera { position: sticky; top: 0; z-index: 30; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--borde); }
      .cabecera-fila { display: flex; align-items: center; gap: 2rem; height: 70px; }
      .marca { display: flex; align-items: center; gap: .6rem; font-size: 1.2rem; color: var(--marino); }
      .marca strong { color: var(--azul); }
      .marca-icono { width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center; background: linear-gradient(135deg, var(--azul), var(--celeste)); font-size: 1.1rem; }
      .nav { display: flex; gap: 1.5rem; margin-left: auto; }
      .nav a { font-weight: 700; color: var(--texto-suave); font-size: .92rem; }
      .nav a:hover { color: var(--azul); }

      .pie { background: var(--marino); color: #cbd5e1; padding: 3rem 0 1.25rem; margin-top: 4rem; }
      .pie .marca { color: #fff; margin-bottom: .7rem; }
      .pie .marca strong { color: var(--celeste); }
      .pie-rejilla { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem; }
      .pie h4 { color: #fff; margin-bottom: .7rem; }
      .pie p { font-size: .9rem; margin-bottom: .3rem; }
      .pie-texto { max-width: 340px; }
      .derechos { text-align: center; font-size: .8rem; color: #64748b; margin-top: 2.5rem; }

      @media (max-width: 760px) {
        .nav { display: none; }
        #btn-acceso { margin-left: auto; padding: .55rem .8rem; }
        .cabecera-fila { gap: .75rem; }
        .marca { font-size: 1.05rem; }
        .pie-rejilla { grid-template-columns: 1fr; }
      }
      @media (max-width: 400px) { .gt { display: none; } }
    </style>
  </body>
</html>
